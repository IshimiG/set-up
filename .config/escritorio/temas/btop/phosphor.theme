# btop en el tema phosphor: fósforo verde sobre negro, de una sola tinta. No hay
# tema oficial; es propio, con los verdes de phosphor.conf: los degradados van
# del verde apagado (#0a3a0a, #00a600) al vivo (#00ff00) y al casi blanco
# (#b0ffb0) en lo más alto, como un fósforo que satura.

theme[main_bg]="#000000"
theme[main_fg]="#00ff00"
theme[title]="#23ff18"
theme[hi_fg]="#b0ffb0"
theme[selected_bg]="#083905"
theme[selected_fg]="#b0ffb0"
theme[inactive_fg]="#0a5a0a"
theme[graph_text]="#00d900"
theme[meter_bg]="#0a1a0a"
theme[proc_misc]="#00d900"
theme[cpu_box]="#00a600"
theme[mem_box]="#00a600"
theme[net_box]="#00a600"
theme[proc_box]="#00a600"
theme[div_line]="#0a3a0a"

theme[temp_start]="#00a600"
theme[temp_mid]="#00ff00"
theme[temp_end]="#b0ffb0"
theme[cpu_start]="#00a600"
theme[cpu_mid]="#00ff00"
theme[cpu_end]="#b0ffb0"
theme[free_start]="#0a3a0a"
theme[free_mid]="#00a600"
theme[free_end]="#00ff00"
theme[cached_start]="#0a3a0a"
theme[cached_mid]="#00a600"
theme[cached_end]="#00ff00"
theme[available_start]="#0a3a0a"
theme[available_mid]="#00a600"
theme[available_end]="#00ff00"
theme[used_start]="#00a600"
theme[used_mid]="#00ff00"
theme[used_end]="#b0ffb0"
theme[download_start]="#0a3a0a"
theme[download_mid]="#00a600"
theme[download_end]="#00ff00"
theme[upload_start]="#0a3a0a"
theme[upload_mid]="#00a600"
theme[upload_end]="#00ff00"
theme[process_start]="#00a600"
theme[process_mid]="#00ff00"
theme[process_end]="#b0ffb0"
