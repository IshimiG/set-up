{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "margin-top": 3,
  "margin-left": 12,
  "margin-right": 12,
  "height": 26,
  "modules-left": [
    "hyprland/workspaces"
  ],
  // El reloj, y pegados a él la campana de notificaciones y el botón de
  // sesión. Estaban al final del bloque derecho, detrás de toda la telemetría;
  // aquí son lo que se busca a propósito, no algo que se lee de pasada.
  "modules-center": [
    "clock",
    "custom/notifications",
    "custom/power"
  ],
  // Telemetría y periféricos; la bandeja cierra pegada al borde derecho.
  "modules-right": [
    "custom/media",
    "custom/loopback",
    "pulseaudio",
    "cpu",
    "temperature",
    "memory",
    "custom/gpu",
    "custom/mouse",
    "group/tray-expander"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "1": "<span color='#e90b25'>󱓻</span>",
      "2": "<span color='#e59625'>󱓻</span>",
      "3": "<span color='#ffd966'>󱓻</span>",
      "4": "<span color='#deffa0'>󱓻</span>",
      "5": "<span color='#6dc89e'>󱓻</span>",
      "6": "<span color='#40e0d0'>󱓻</span>",
      "7": "<span color='#00aef2'>󱓻</span>",
      "8": "<span color='#bf3e81'>󱓻</span>",
      "9": "<span color='#df6280'>󱓻</span>",
      "10": "<span color='#ffe9ff'>󱓻</span>",
      "active": "<span color='#6dc89e'>󱓻</span>"
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": []
    }
  },
  // El día y la fecha van atenuados y la hora a plena opacidad, para que la
  // hora se lea de un vistazo y el resto quede como contexto. Clic izquierdo
  // cambia a la fecha larga con número de semana, clic derecho alterna la vista
  // del calendario entre mes y año, y la rueda mueve el mes mostrado.
  "clock": {
    "format": "<span alpha='55%'>{0:L%a %d}</span>  {0:L%H:%M}",
    "format-alt": "{0:L%d %B %Y}<span alpha='55%'>  ·  semana {0:L%V}</span>",
    "tooltip": true,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "format": {
        "months": "<span color='#ffffff'><b>{}</b></span>",
        "days": "<span color='#d6d6d6'>{}</span>",
        "weeks": "<span color='#6dc89e'><b>W{}</b></span>",
        "weekdays": "<span color='#40e0d0'><b>{}</b></span>",
        "today": "<span color='#e59625'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  // Lo que está sonando en cualquier reproductor MPRIS. El script va en modo
  // continuo (playerctl --follow), así que no hay intervalo: reacciona al
  // instante y desaparece de la barra cuando no hay nada reproduciéndose.
  "custom/media": {
    "exec": "$HOME/.config/waybar/scripts/media.sh",
    "return-type": "json",
    "format": "{icon}  {text}",
    "format-icons": {
      "playing": "󰎈",
      "paused": "󰏤"
    },
    "max-length": 45,
    "escape": true,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "on-scroll-up": "playerctl position 10+",
    "on-scroll-down": "playerctl position 10-"
  },
  // Loopback del micrófono a los auriculares: escucharte a ti mismo en directo.
  // Portado de la extensión de GNOME; comparte el estado por GSettings con la
  // app GTK3, así que cambiar el micro allí se refleja aquí. El módulo no se
  // oculta cuando está apagado, porque sin glifo no habría dónde hacer clic
  // para encenderlo. El refresco real llega por señal (SIGRTMIN+8) para que el
  // clic se vea al instante; el intervalo sólo cubre los cambios hechos desde
  // fuera de la barra.
  "custom/loopback": {
    "exec": "$HOME/.config/waybar/scripts/loopback.sh waybar",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "format": "{}",
    "on-click": "$HOME/.config/waybar/scripts/loopback.sh toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "$HOME/.config/waybar/scripts/loopback.sh up",
    "on-scroll-down": "$HOME/.config/waybar/scripts/loopback.sh down"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "scroll-step": 5,
    "tooltip-format": "{desc} · {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "cpu": {
    "interval": 3,
    "format": "󰍛  {usage}%",
    "tooltip-format": "CPU {usage}% · carga {load}",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "on-click": "ghostty --title=btop -e btop"
  },
  // Tctl del k10temp del 7800X3D. La ruta es la del dispositivo PCI, no
  // /sys/class/hwmon/hwmonN, porque la numeración hwmon cambia entre arranques.
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 3,
    "format": "{temperatureC}°",
    "critical-threshold": 85,
    "tooltip-format": "CPU Tctl · {temperatureC}°C",
    "on-click": "ghostty --title=btop -e btop"
  },
  "memory": {
    "interval": 5,
    "format": "󰘚  {percentage}%",
    "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB\nSwap {swapUsed:0.1f} GiB",
    "states": {
      "warning": 80,
      "critical": 92
    },
    "on-click": "ghostty --title=btop -e btop"
  },
  "custom/gpu": {
    "exec": "$HOME/.config/waybar/scripts/gpu.sh",
    "return-type": "json",
    "interval": 3,
    "format": "󰢮  {}",
    "on-click": "ghostty --title=btop -e btop"
  },
  // Batería del Razer Viper V3 Pro SE, leída por HID contra su nodo hidraw.
  // Un minuto de intervalo sobra: la carga de un ratón no se mueve más rápido.
  "custom/mouse": {
    "exec": "$HOME/.config/waybar/scripts/mouse-battery.py",
    "return-type": "json",
    "interval": 60,
    "format": "󰍽  {}"
  },
  // Campana: clic abre el centro de notificaciones con el historial, clic
  // derecho pone y quita el silencio. Sin intervalo, como el botón de sesión:
  // el estado sólo cambia cuando uno lo cambia, y quien lo cambia avisa por
  // SIGRTMIN+10.
  "custom/notifications": {
    "exec": "$HOME/.config/waybar/scripts/notifications.sh",
    "return-type": "json",
    "signal": 10,
    "format": "{}",
    "tooltip": true,
    "on-click": "$HOME/.config/hypr/scripts/notify-ctl.sh centro",
    "on-click-right": "$HOME/.config/hypr/scripts/notify-ctl.sh silencio"
  },

  // Botón de sesión: abre un menú con bloquear, suspender, cerrar sesión,
  // reiniciar y apagar. Va el último de la barra porque es la esquina donde se
  // busca por costumbre, y el clic derecho bloquea directo, que es la única de
  // las cinco que se usa a diario.
  //
  // El texto es fijo, pero el módulo va por script para poder llevar la clase
  // "open" mientras el menú está desplegado y que el botón siga encendido
  // aunque el ratón se haya ido a otra parte. Sin intervalo: se redibuja sólo
  // cuando le llega la señal (SIGRTMIN+9), que mandan el interruptor y el
  // propio menú al cerrarse.
  "custom/power": {
    "exec": "$HOME/.config/waybar/scripts/power-state.sh",
    "return-type": "json",
    "signal": 9,
    "format": "{}",
    "tooltip": true,
    "on-click": "$HOME/.config/waybar/scripts/power-menu.sh",
    "on-click-right": "hyprlock"
  },

  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "tray"
    ]
  },
  "custom/expand-icon": {
    "format": "󰇘",
    "tooltip": false,
    "on-scroll-up": "",
    "on-scroll-down": "",
    "on-scroll-left": "",
    "on-scroll-right": ""
  },
  "tray": {
    "icon-size": 12,
    "spacing": 17
  }
}
